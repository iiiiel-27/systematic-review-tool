{
  "databases": {
    "semantic_scholar": false,
    "openalex": true,
    "eric": true,
    "crossref": true,
    "arxiv": false
  },
  "keyword_groups": [
    {
      "label": "your-topic-1",
      "terms": [
        "your first keyword",
        "another keyword",
        "synonym or related phrase"
      ]
    },
    {
      "label": "your-topic-2",
      "terms": [
        "second topic keyword",
        "another related term"
      ]
    }
